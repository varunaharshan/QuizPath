{
  "name": "quizpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "cross-env NODE_OPTIONS=--conditions=react-server tsx src/db/seed.ts",
    "db:backfill-keywords": "cross-env NODE_OPTIONS=--conditions=react-server tsx src/db/backfill-keywords.ts",
    "db:backfill-question-sort-order": "cross-env NODE_OPTIONS=--conditions=react-server tsx src/db/backfill-question-sort-order.ts",
    "db:migrate-options-format": "cross-env NODE_OPTIONS=--conditions=react-server tsx src/db/migrate-options-format.ts",
    "db:unpublish-placeholders": "cross-env NODE_OPTIONS=--conditions=react-server tsx src/db/unpublish-placeholder-mcqs.ts",
    "db:check-no-published-placeholders": "cross-env NODE_OPTIONS=--conditions=react-server tsx src/db/check-no-published-placeholders.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.12",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "papaparse": "^5.5.4",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "svix": "^1.96.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
